PROPOSED PATCH - UNTESTED ON GPU.
Port of vllm-project/vllm#55341 (upstream commit 685074cd6, "[V2] Warm up kernels before capturing CUDA
graphs") to the engine's model runner V2: run warmup_kernels before capture_model, and lock the shared
workspace at the end of capture_model. The upstream commit also adds a profile_only flag to
capture_model for its CUDA-graph memory profiler; this engine's profiler does not call capture_model,
so that part is not needed here. Against the 0.9.1 package; applies with `patch -p1` from the
directory that contains vllm/. Checked on CPU only (applies; static check, see expected/). Not run on
a GPU. Behaviour change to review: after this patch a workspace request larger than the size reached
by warm-up and capture raises an AssertionError ("Workspace is locked") instead of silently
reallocating.

--- a/vllm/v1/worker/gpu_worker.py
+++ b/vllm/v1/worker/gpu_worker.py
@@ -714,6 +714,11 @@
         # cuda graph capture.
         kernel_warmup(self)
 
+        if self.use_v2_model_runner:
+            # Run the scheduler-realistic warm-up before capture: a workspace
+            # resize after capture frees the buffer captured graphs point at.
+            warmup_kernels(self.model_runner, self.execute_model, self.sample_tokens)
+
         cuda_graph_memory_bytes = 0
         if not self.model_config.enforce_eager:
             cuda_graph_memory_bytes = self.model_runner.capture_model()
@@ -792,10 +797,7 @@
 
             maybe_save_startup_plan(self, kv_cache_memory_bytes_to_requested_limit)
 
-        if self.use_v2_model_runner:
-            # V2: Run full execute_model + sample_tokens to JIT compile triton kernels.
-            warmup_kernels(self.model_runner, self.execute_model, self.sample_tokens)
-        elif get_pp_group().is_last_rank:
+        if not self.use_v2_model_runner and get_pp_group().is_last_rank:
             # V1: Warm up sampler and preallocate memory buffer for logits and other
             # sampling related tensors of max possible shape to avoid memory
             # fragmentation issue.
--- a/vllm/v1/worker/gpu/model_runner.py
+++ b/vllm/v1/worker/gpu/model_runner.py
@@ -149,6 +149,7 @@
     copy_kv_cache_blocks_inplace,
     get_uniform_decode_token_count,
 )
+from vllm.v1.worker.workspace import lock_workspace
 
 logger = init_logger(__name__)
 
@@ -1025,6 +1026,10 @@
                             self._dummy_run(**batch)
                     self.adaptive_verification.set_initial_cost_curves(timings)
 
+        # Lock the workspace: a resize after capture would free the buffer the
+        # captured graphs point at; growth now fails loudly instead.
+        lock_workspace()
+
         end_time = time.perf_counter()
         end_free_gpu_memory = torch.accelerator.get_memory_info()[0]
         elapsed_time = end_time - start_time
