#!/usr/bin/env bash
# TEST SHIM for run_k_selection.sh refusal/cleanup tests. Never calls the real docker.
echo "docker $*" >> "${SHIM_LOG:-/dev/null}"
case "$1" in
  image) if [ "${SHIM_BAD_IMAGE:-0}" = 1 ]; then echo "sha256:0000000000000000"; else echo "$3"; fi ;;
  ps)    if [ "${SHIM_BUSY:-0}" = 1 ]; then echo "glm53-flash-exl3-b12x-vllm 08d1cb902ddb"; fi ;;
  run)   exec sleep "${SHIM_RUN_SLEEP:-0}" ;;
  rm)    exit 0 ;;
  *)     exit 0 ;;
esac
