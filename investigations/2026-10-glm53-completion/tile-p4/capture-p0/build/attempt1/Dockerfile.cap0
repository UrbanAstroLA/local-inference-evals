    "76ede504eb29c2e2baaf339f0d90eac595a43e7f41056c0971f1d5d1cb9dfe30  ${VP}/cap0_hooks.py" \
    "58d4b4d8c8046bfdb99ea8b03867ac053b35d73299dc90779b8242630e81655e  ${VP}/cap0_hooks_layout.py" \
  | sha256sum -c - \
 && python3 -m py_compile ${VP}/p4_hooks.py ${VP}/cap0_hooks.py ${VP}/cap0_hooks_layout.py \
 && test "$(grep -c '# local-cap0$' ${VP}/p4_hooks.py)" = 19 \
 && CUDA_VISIBLE_DEVICES= GLM53_P4=on GLM53_P4_S0=on python3 -c "import sys, vllm.p4_hooks as p; assert p._cap0 is None and 'vllm.cap0_hooks' not in sys.modules" \
 && CUDA_VISIBLE_DEVICES= GLM53_P4=on GLM53_P4_S0=on GLM53_CAP0=on python3 -c "import vllm.p4_hooks as p; assert p._cap0 is not None and p._cap0.ON and not p._cap0.LOC and not p._cap0.S.registered"
